# Local development configuration
#
# Copy this file to ".env" (or just run `make setup-env`) and set PROJECT_ID
# to your Google Cloud project. Everything else is derived for you.

PROJECT_ID=CHANGE_ME

# --- Vertex AI authentication ---
# Tell the Google GenAI SDK (used by ADK) to authenticate via Vertex AI with
# your gcloud Application Default Credentials — no API key required. Without
# GOOGLE_GENAI_USE_VERTEXAI=true, `adk web` fails with a "No valid API key" error.
# GOOGLE_CLOUD_PROJECT/LOCATION use ${PROJECT_ID} interpolation so you only edit
# PROJECT_ID above once.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=${PROJECT_ID}
GOOGLE_CLOUD_LOCATION=global

# These values don't need to change
LOCATION=global
VECTOR_SEARCH_COLLECTION_ID=news-articles
VECTOR_SEARCH_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001
SKIP_SCRAPING_IF_CACHED=true
